<Window
    x:Class="LinkedPlayer.Client.Avalonia.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:LinkedPlayer.Client.Avalonia.ViewModels"
    Title="LinkedPlayer.Client.Avalonia"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:SyncViewModel"
    mc:Ignorable="d">
    <Grid>
        <StackPanel>
            <TextBlock Text="Username" />
            <TextBox Text="{Binding Username, Mode=TwoWay}" />
            <StackPanel Orientation="Horizontal">
                <TextBox Text="{Binding RoomId, Mode=TwoWay}" />
                <Button Command="{Binding JoinRoomCommand}" Content="Join" />
                <Button Command="{Binding CreateRoomCommand}" Content="Create" />
            </StackPanel>
            <TextBlock Text="Message" />
            <TextBox Text="{Binding Message, Mode=TwoWay}" />
        </StackPanel>
    </Grid>
</Window>
